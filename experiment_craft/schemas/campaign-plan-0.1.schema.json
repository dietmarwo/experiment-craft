{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experiment-craft:schema:campaign-plan-0.1",
  "title": "experiment.campaign.plan/0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "experiment.campaign.plan/0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9 _.-]+$"
    },
    "allow_commands": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_jobs",
        "max_wall_seconds",
        "max_reserved_slot_seconds"
      ],
      "properties": {
        "max_jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "max_wall_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 604800
        },
        "max_reserved_slot_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2551814553600
        }
      }
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 81
          },
          "template": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "axes": {
            "type": "object"
          },
          "job": {
            "type": "object"
          },
          "accept": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "require_feasible": {
                "type": "boolean"
              },
              "claims": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            }
          },
          "executable": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "argv0": {
                    "type": "string"
                  },
                  "resolved": {
                    "type": "string"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "argv0",
                  "resolved",
                  "bytes",
                  "sha256"
                ]
              }
            ]
          },
          "reserved_slot_seconds": {
            "type": "number",
            "minimum": 0
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "template",
          "axes",
          "job",
          "accept",
          "executable",
          "reserved_slot_seconds",
          "needs"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "name",
    "allow_commands",
    "budget",
    "plan_id",
    "steps"
  ]
}
