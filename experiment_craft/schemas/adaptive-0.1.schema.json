{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experiment-craft:adaptive:0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "experiment.adaptive/0.1"
    },
    "problem": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:bo-craft:problem:0.1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "bo.problem/0.1"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "type": {
                "enum": [
                  "continuous",
                  "integer",
                  "categorical"
                ]
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "minItems": 1,
                "maxItems": 1000
              },
              "log": {
                "type": "boolean"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "active_if": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              }
            },
            "required": [
              "name",
              "type"
            ]
          },
          "minItems": 1,
          "maxItems": 128
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "direction": {
                "enum": [
                  "minimize",
                  "maximize"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "name",
              "direction"
            ]
          },
          "minItems": 1,
          "maxItems": 8
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "name"
            ]
          },
          "minItems": 0,
          "maxItems": 16
        },
        "input_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "coefficients": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "maxProperties": 32
              },
              "upper": {
                "type": "number"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "coefficients",
              "upper"
            ]
          },
          "minItems": 0,
          "maxItems": 64
        },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parameter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "target": {
              "type": "number"
            },
            "cost_intercept": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "cost_weight": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "parameter",
            "target",
            "cost_intercept",
            "cost_weight"
          ]
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "id",
            "version"
          ]
        }
      },
      "required": [
        "schema_version",
        "parameters",
        "objectives"
      ]
    },
    "config": {
      "type": "object",
      "description": "BO-craft request configuration; validated by BO-craft's request schema"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4611686018427387904
    },
    "concurrent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "python": {
      "type": "string",
      "pattern": "^/",
      "minLength": 1
    },
    "proposal_slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "proposal_wall_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "evaluator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "command"
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "slots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "wall_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$"
                  }
                },
                "required": [
                  "file",
                  "path"
                ]
              }
            }
          },
          "required": [
            "kind",
            "argv",
            "slots",
            "wall_seconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "native"
            },
            "job": {
              "type": "object"
            },
            "seeded": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "job"
          ]
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slot_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "evaluations",
        "jobs",
        "wall_seconds",
        "slot_seconds"
      ]
    },
    "proposal_lookahead": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "boolean"
        },
        "validation_replicates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "validate": {
          "enum": [
            "empirical",
            "model"
          ]
        }
      }
    },
    "pruning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "median"
        },
        "startup_trials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "warmup_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "progress_max_bytes": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16777216
        },
        "check_seconds": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 3600
        }
      },
      "required": [
        "policy"
      ]
    }
  },
  "required": [
    "schema_version",
    "problem",
    "config",
    "seed",
    "concurrent",
    "python",
    "proposal_slots",
    "proposal_wall_seconds",
    "evaluator",
    "budget"
  ]
}
