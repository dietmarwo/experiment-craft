{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experiment-craft:schema:campaign-maintenance-0.1",
  "title": "experiment.campaign.maintenance/0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "experiment.campaign.maintenance/0.1"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "paused": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775808
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "restored_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "paused",
    "generation",
    "reason",
    "restored_from"
  ]
}
