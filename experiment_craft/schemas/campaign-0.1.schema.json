{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:experiment-craft:schema:campaign-0.1",
  "title": "experiment.campaign/0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "budget",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment.campaign/0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9 _.-]+$"
    },
    "allow_commands": {
      "type": "boolean"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_jobs",
        "max_wall_seconds",
        "max_reserved_slot_seconds"
      ],
      "properties": {
        "max_jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "max_wall_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 604800
        },
        "max_reserved_slot_seconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 2551814553600
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "job"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "needs": {
            "type": "array",
            "maxItems": 1024,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "matrix": {
            "type": "object",
            "maxProperties": 16,
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096
            }
          },
          "job": {
            "type": "object"
          },
          "accept": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "require_feasible": {
                "type": "boolean"
              },
              "claims": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            }
          }
        }
      }
    }
  }
}
